# The chart lives at the repo root alongside the app source; keep everything
# that isn't chart metadata / templates out of the packaged chart.
app/
Dockerfile
build.sh
upgrade.sh
*.md
# README banner + the seeded-demo screenshots: ~900K of PNG, which neither
# gzips nor base64s down, and helm stores the whole packaged chart in the
# release Secret. Without this the upgrade dies on the 1 MiB Secret limit.
docs/
.git/
.gitignore
.dockerignore
.venv/
__pycache__/
*.pyc
*.tgz
values.local.yaml

# 1Password reference templates — never part of the packaged chart.
values.local.tpl.yaml
